#!/usr/bin/env bash

# Authenticate git clones from github.com using the runtime GITHUB_TOKEN to
# avoid GitHub's unauthenticated rate limit. Only the helper is baked in.
set -eux

sudo git config --system credential."https://github.com".helper \
    '!f() { echo username=x-access-token; echo "password=${GITHUB_TOKEN}"; }; f'
